{
    "name": "jslings",
    "version": "0.0.1",
    "bin": "cli.js",
    "type": "module",
    "engines": {
        "node": ">=8"
    },
    "description": "The easiest way to get started with JavaScript. 🐢",
    "main": "index.js",
    "repository": "git@github.com:XifeiNi/jslings.git",
    "author": "Anthony Morris <anthony@amorrissound.com>",
    "contributors": [],
    "license": "MIT",
    "devDependencies": {
        "@babel/preset-react": "^7.10.4",
        "@babel/register": "^7.11.5",
        "@types/commander": "^2.12.2",
        "@types/jest": "^30.0.0",
        "@types/jest-cli": "^24.3.0",
        "@types/node": "^24.5.2",
        "@types/react": "^19.1.14",
        "@types/uuid": "^11.0.0",
        "chalk": "^5.6.2",
        "eslint-config-xo-react": "^0.28.0",
        "eslint-plugin-jest": "^29.0.1",
        "eslint-plugin-react": "^7.21.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "ink-testing-library": "^4.0.0",
        "jest-junit": "^16.0.0",
        "nodemon": "^3.1.10",
        "plop": "^4.0.4",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2",
        "xo": "^1.2.2"
    },
    "scripts": {
        "jslings": "node --loader ts-node/esm ./src/cli/index.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "xo && jest",
        "generate": "plop --plopfile ./src/generator/plopfile.ts"
    },
    "files": [
        "dist/ui.js",
        "dist/cli.js"
    ],
    "babel": {
        "presets": [
            "@babel/preset-react"
        ]
    },
    "xo": {
        "plugins": [
            "jest"
        ],
        "extends": [
            "xo-react/space",
            "plugin:jest/recommended"
        ],
        "rules": {
            "react/prop-types": "off"
        },
        "prettier": true
    },
    "dependencies": {
        "commander": "^14.0.1",
        "immer": "^10.1.3",
        "ink": "^6.3.1",
        "jest": "^30.1.3",
        "jest-cli": "^30.1.3",
        "nullthrows": "^1.1.1",
        "prop-types": "^15.7.2",
        "react": "^19.1.1",
        "uuid": "^13.0.0"
    }
}
